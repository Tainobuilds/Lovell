# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://lovellmedia.com

# Contact form delivery: set one or both.
# Option A: Resend (https://resend.com), email straight to the inbox
RESEND_API_KEY=
# Defaults to contact@latoyalovell.com (src/content/site.ts). Comma-separate for several.
CONTACT_TO_EMAIL=
# Leave empty to use Resend's test sender (onboarding@resend.dev). That only
# delivers to the Resend account's own email, so sign up with contact@latoyalovell.com.
# Once lovellmedia.com is verified in Resend, set e.g. "Lovell Media <website@lovellmedia.com>".
CONTACT_FROM_EMAIL=
# Option B: any webhook (Zapier, Make, Slack, CRM) receives JSON
CONTACT_WEBHOOK_URL=

# Content editor on the live site (see docs/CONTENT-EDITOR.md). Leave unset to
# edit locally only. The four KEYSTATIC_* values are created by Keystatic's
# GitHub App setup; they are secrets, so set them in Vercel, never commit them.
NEXT_PUBLIC_KEYSTATIC_STORAGE=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
